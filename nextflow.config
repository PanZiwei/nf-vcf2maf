// Input parameters
params.input 				= null
params.reference_fasta 		= "s3://sage-igenomes/igenomes/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta"
params.reference_fasta_fai 	= "${params.reference_fasta}.fai"
params.vep_tarball 			= "s3://sage-igenomes/vep_cache/homo_sapiens_vep_107_GRCh38.tar.gz"

// Resource limits
params.max_cpus   = 16
params.max_memory = '128.GB'

// vcf2maf parameters
// vep_path: VEP binary location inside the container — update when switching vcf2maf images
params.vep_path         = "/root/miniconda3/envs/vep/bin"
params.maf_center 			= "Sage Bionetworks"
params.max_subpop_af 		= 0.0005
params.ncbi_build 			= "GRCh38"
params.species 				= "homo_sapiens"
params.vep_stats_params		= true  // Pass --vep-stats to vcf2maf to prevent internal --no_stats

// Process configuration
// To update containers, change the withLabel container values below
process {
  maxErrors     = '-1'
  maxRetries    = 3
  errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }

  withLabel: synapse {
    container = 'sagebionetworks/synapsepythonclient:v2.6.0'
  }
  withLabel: vcf2maf {
    container = 'sagebionetworks/vcf2maf:107.2'
  }
  withLabel: python {
    container = 'python:3.10.4'
  }
  withLabel: vcf2maf_compute {
    cpus   = { Math.min(6, params.max_cpus as int) }
    memory = { [64.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
  }
  withLabel: merge_compute {
    memory = { [16.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
  }
}

// Profiles
profiles {

    docker {
        docker.enabled         = true
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }

}
